{
  enable: true,
  neural_networks_folder: "etc/neural_networks",
  model_name: "yolo26m-pose=f17+ball-detection+field-pose+robot-pose~synthetic-all-venues.onnx",
  object_detection_parameters: {
    maximum_intersection_over_union: 0.4,
    minimum_candidate_confidence: 0.05,
  },
  robot_pose_detection_parameters: {
    maximum_intersection_over_union: 0.4,
    minimum_candidate_confidence: 0.05,
  },
  pose_detection_parameters: {
    maximum_intersection_over_union: 0.4,
    minimum_candidate_confidence: 0.05,
  },
}
