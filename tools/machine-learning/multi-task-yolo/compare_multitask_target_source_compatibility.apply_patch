+    def test_source_tree_hash_includes_untracked_python_contents(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / "a.py").write_text("value = 1\n", encoding="utf-8")
+            (root / "ignored.txt").write_text("one\n", encoding="utf-8")
+            baseline = _source_tree_sha256(root)
+            (root / "ignored.txt").write_text("two\n", encoding="utf-8")
+            self.assertEqual(baseline, _source_tree_sha256(root))
+            (root / "a.py").write_text("value = 2\n", encoding="utf-8")
+            self.assertNotEqual(baseline, _source_tree_sha256(root))
