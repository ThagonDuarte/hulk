+fn read_model_run_manifest(path: &Path) -> Result<ModelRunManifest> {
+    match read_bincode(path) {
+        Ok(manifest) => Ok(manifest),
+        Err(current_error) => read_bincode::<PriorModelRunManifest>(path)
+            .map(ModelRunManifest::from)
+            .map_err(|prior_error| {
+                prior_error.wrap_err(format!(
+                    "also failed to decode current model run manifest: {current_error:#}"
+                ))
+            }),
+    }
+}
