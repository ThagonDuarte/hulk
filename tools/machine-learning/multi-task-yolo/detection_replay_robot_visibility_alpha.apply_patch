+pub(crate) fn validate_robot_visibility_score_alpha(value: f32) -> Result<f32> {
+    if !value.is_finite() || value < 0.0 {
+        bail!("robot visibility score alpha must be finite and non-negative, got {value}");
+    }
+    Ok(normalize_zero(value))
+}
