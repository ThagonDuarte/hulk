+fn parse_robot_visibility_alpha(value: &str) -> std::result::Result<f32, String> {
+    let alpha = value
+        .parse::<f32>()
+        .map_err(|error| format!("invalid robot visibility alpha `{value}`: {error}"))?;
+    if !alpha.is_finite() || alpha < 0.0 {
+        return Err(format!(
+            "robot visibility alpha must be finite and non-negative, got {value}"
+        ));
+    }
+    Ok(if alpha == 0.0 { 0.0 } else { alpha })
+}
